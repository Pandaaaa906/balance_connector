<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="balance_connector"
           Manufacturer="Pandaaaa906"
           Version="$(var.Version)"
           UpgradeCode="db86ffd8-a4a2-4c4d-8140-c31ff42c9cf7"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of balance_connector is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="Main">
      <ComponentGroupRef Id="MainComponents" />
    </Feature>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLDIR" Name="balance_connector" />
    </StandardDirectory>

    <ComponentGroup Id="MainComponents" Directory="INSTALLDIR">
      <Component Id="AppExe" Guid="*">
        <File Id="balance_connector.exe" Source="build/balance_connector.exe" KeyPath="yes" />
        <!-- 服务由 nssm 注册、WiX 不知情：升级/卸载旧产品时按服务名显式停止 -->
        <ServiceControl Id="SvcStopOnUninstall" Name="balance_connector" Stop="uninstall" Wait="yes" />
      </Component>
      <Component Id="NssmExe" Guid="*">
        <File Id="nssm.exe" Source="build/nssm.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- WiX v4 的 installed-file exe CA：FileRef 让 MSI 自行解析安装后路径，
         ExeCommand 只放参数；[INSTALLDIR] 由引擎在执行序列中格式化 -->
    <CustomAction Id="SvcInstall" FileRef="nssm.exe" Execute="deferred" Return="check"
                  ExeCommand="install balance_connector &quot;[INSTALLDIR]balance_connector.exe&quot;" />
    <CustomAction Id="SvcStart" FileRef="nssm.exe" Execute="deferred" Return="ignore"
                  ExeCommand="start balance_connector" />
    <CustomAction Id="SvcStop" FileRef="nssm.exe" Execute="deferred" Return="ignore"
                  ExeCommand="stop balance_connector" />
    <CustomAction Id="SvcRemove" FileRef="nssm.exe" Execute="deferred" Return="ignore"
                  ExeCommand="remove balance_connector confirm" />

    <InstallExecuteSequence>
      <!-- 停服务（单点调度，WiX v4 禁止同一 Action 调度两次）：
           REMOVE="ALL" 覆盖卸载（含未来新版互升时旧产品的卸载段）；
           WIX_UPGRADE_DETECTED 覆盖本次升级——0.0.2 旧包的卸载序列（Windows\Installer 缓存表）
           只 sc delete 不停服务，必须在新包序列里、RemoveExistingProducts/InstallFiles 之前停，
           否则 exe 被占用导致升级失败或要求重启。 -->
      <Custom Action="SvcStop" Before="RemoveExistingProducts" Condition="REMOVE=&quot;ALL&quot; OR WIX_UPGRADE_DETECTED" />
      <Custom Action="SvcRemove" After="SvcStop" Condition="REMOVE=&quot;ALL&quot;" />
      <!-- 全新安装（MajorUpgrade 先卸旧版，此时 NOT Installed 成立）：装服务并启动 -->
      <Custom Action="SvcInstall" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="SvcStart" After="SvcInstall" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
